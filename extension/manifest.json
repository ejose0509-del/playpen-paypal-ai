{
  "manifest_version": 3,
  "name": "Bramble for PlayPen",
  "version": "0.2.0",
  "description": "Bramble the hedgehog follows you around Chrome, finds organic food and demo partner brands on Amazon, and earns your PlayPen farm a little XP.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Bramble for PlayPen",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://*.onrender.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1/*",
        "http://localhost/*",
        "https://*.onrender.com/*"
      ],
      "js": [
        "pair.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "bramble-rig.js",
        "bramble.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "bramble.png",
        "bramble-talk.png",
        "BreeSerif-Regular.ttf"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
