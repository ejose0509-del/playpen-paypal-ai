# Copy to .env and fill in. .env is ignored by git; never commit real keys.

# PayPal Sandbox REST app (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_CLIENT_SECRET=

# Claude, for Bramble the companion (console.anthropic.com)
ANTHROPIC_API_KEY=

# Channel3 product search for Bramble in Chrome (trychannel3.com), optional
CHANNEL3_API_KEY=

# Public origin for PayPal return links. Defaults to http://localhost:8000.
# On Render this comes from RENDER_EXTERNAL_URL automatically.
# PLAYPEN_BASE_URL=http://localhost:8000

# Session signing key. If unset, one is generated in instance/session.key.
# PLAYPEN_SESSION_KEY=
